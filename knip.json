{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/agent-edge.mjs",
        "scripts/**/*.mjs",
        "e2e/**/*.ts",
        "e2e-live/**/*.ts"
      ],
      "project": [
        "src/**/*.{ts,mjs}",
        "scripts/**/*.mjs",
        "test/**/*.{ts,mjs}",
        "playground/**/*.{ts,tsx,js}",
        "e2e/**/*.ts",
        "e2e-live/**/*.ts"
      ],
      "ignoreDependencies": ["jscpd"]
    },
    "site": {
      "entry": ["scripts/**/*.mjs"],
      "project": ["src/**/*.{ts,astro}", "scripts/**/*.mjs"]
    },
    "docs-blume": {
      "entry": [
        "blume.config.ts",
        "components.ts",
        "pages/index.astro",
        "starlight-components.ts",
        "starlight-tab-item.astro"
      ],
      "ignoreBinaries": ["blume"],
      "ignoreDependencies": ["astro"]
    }
  }
}
