{
  "$schema": "fleet.design-review.v1",
  "version": 1,
  "project": "free-ai",
  "target": "AI Gateway dashboard density and mobile containment",
  "mode": "preserve",
  "register": "product",
  "context": {
    "product": "PRODUCT.md",
    "design": "DESIGN.md"
  },
  "direction": {
    "references": [],
    "probes": [],
    "selected": "existing-design",
    "approval": "not-required",
    "before": ".fleet/evidence/dashboard-mobile/before-1440.png"
  },
  "evidence": {
    "screenshots": [
      {
        "width": 390,
        "path": ".fleet/evidence/dashboard-mobile/after-390.png"
      },
      {
        "width": 768,
        "path": ".fleet/evidence/dashboard-mobile/after-768.png"
      },
      {
        "width": 1440,
        "path": ".fleet/evidence/dashboard-mobile/after-1440.png"
      }
    ],
    "projectCheck": {
      "command": "pnpm run typecheck",
      "status": "pass"
    },
    "critique": {
      "score": 36,
      "maximum": 40
    },
    "audit": {
      "score": 19,
      "maximum": 20
    },
    "unresolved": {
      "p0": 0,
      "p1": 0
    },
    "detector": {
      "posture": "advisory",
      "findings": []
    },
    "browserReview": {
      "tool": "Browser control",
      "viewports": [390, 768, 1440],
      "horizontalOverflow": false,
      "consoleErrors": 0,
      "note": "The dashboard is page-contained at 390px, all four data tables scroll inside their cards, controls meet 44px mobile targets, and tablet controls retain a compact operator-console layout."
    }
  },
  "ownerFeedback": {
    "decision": "delegated",
    "note": "The owner explicitly delegated final judgment for the responsive remediation wave; the existing operator-console visual language was preserved."
  }
}
