---
const pages = [
  ['getting-started', 'Getting started', 'Connect an OpenAI-compatible client to the gateway.'],
  ['chat-completions', 'Chat completions', 'Generate text with streaming, tools, JSON mode, and vision.'],
  ['responses-api', 'Responses API', 'Use the OpenAI Responses format through the gateway.'],
  ['models', 'Models', 'Browse routing capabilities and available model families.'],
  ['authentication', 'Authentication', 'Authenticate protected requests with a gateway key.'],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>AI Gateway API Docs</title>
    <meta
      name="description"
      content="OpenAI-compatible API documentation for the Free AI Gateway."
    />
    <style>
      :global(*) { box-sizing: border-box; }
      :global(body) {
        margin: 0;
        background: #0b0f14;
        color: #e7edf5;
        font-family: Inter, ui-sans-serif, system-ui, sans-serif;
      }
      main { max-width: 920px; margin: 0 auto; padding: 5rem 1.5rem; }
      .eyebrow { color: #7dd3fc; font-size: .78rem; letter-spacing: .14em; text-transform: uppercase; }
      h1 { margin: .75rem 0 1rem; font-size: clamp(2.4rem, 7vw, 4.5rem); line-height: 1; }
      p { max-width: 680px; color: #aab7c7; font-size: 1.08rem; line-height: 1.7; }
      code { color: #bae6fd; }
      .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; margin-top: 3rem; }
      .docs-link { color: #bae6fd; }
      .grid a { display: block; height: 100%; padding: 1.25rem; border: 1px solid #263241; border-radius: .75rem; color: inherit; text-decoration: none; background: #111821; }
      .grid a:hover { border-color: #7dd3fc; background: #15202c; }
      h2 { margin: 0 0 .5rem; font-size: 1.05rem; }
      a p { margin: 0; font-size: .92rem; line-height: 1.5; }
      footer { margin-top: 3rem; color: #718096; font-size: .85rem; }
    </style>
  </head>
  <body>
    <main>
      <div class="eyebrow">Free AI Gateway</div>
      <h1>API documentation</h1>
      <p>
        An OpenAI-compatible gateway across free-tier providers. Start with
        <a class="docs-link" href="/docs/getting-started"><code>/docs/getting-started</code></a>
        or jump directly to an API reference below.
      </p>
      <section class="grid" aria-label="Documentation sections">
        {pages.map(([slug, title, description]) => (
          <a href={`/docs/${slug}`}>
            <h2>{title}</h2>
            <p>{description}</p>
          </a>
        ))}
      </section>
      <footer>OpenAI-compatible endpoints live under <code>/v1</code>.</footer>
    </main>
  </body>
</html>
