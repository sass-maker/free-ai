---
const title = 'AI Gateway changelog — Verified updates';
const description =
  'A first-party record of meaningful releases to the sass-maker AI Gateway.';
const gw = 'https://ai-gateway.sassmaker.com';
const sourceUrl = 'https://github.com/sass-maker/free-ai';
const roadmapUrl = `${sourceUrl}/issues`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description,
  url: `${gw}/changelog`,
  isPartOf: { '@id': `${gw}/#website` },
};

const entries = [
  {
    date: 'July 18, 2026',
    title: 'Documentation became one connected system',
    body: 'Product, architecture, development, operations, and knowledge documentation were consolidated into a single maintained tree. The public reference remains generated from the same source material.',
    tags: ['Documentation', 'Maintenance'],
  },
  {
    date: 'July 17, 2026',
    title: 'Public API reference and agent indexes',
    body: 'The gateway gained a searchable public API reference plus llms.txt, full-text agent documentation, an agent catalog endpoint, and crawler guidance.',
    tags: ['API', 'Agent access'],
  },
  {
    date: 'June 28, 2026',
    title: 'Embedding catalog released',
    body: 'Production model discovery began reporting six enabled embedding models with dimensions and aliases. The release was smoke-tested against the live gateway before downstream RAG consumers adopted it.',
    tags: ['Embeddings', 'Production'],
  },
  {
    date: 'May 28, 2026',
    title: 'Free-compute routing audited',
    body: 'Provider allowances and failure modes were reviewed against the gateway’s cost rules. Hugging Face remained a manual probe rather than an automatic production route because its free allowance was too small for the pool.',
    tags: ['Routing', 'Cost'],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`${gw}/changelog`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`${gw}/changelog`} />
    <meta property="og:image" content={`${gw}/icon.svg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap" />
    <style is:inline>
      :root{--bg:#050a0e;--raised:#0a1118;--card:#0d1820;--border:#1a2d3a;--border-bright:#245068;--text:#e4edf3;--secondary:#8aa3b3;--muted:#5d7888;--brand:#38bdf8;--emerald:#10b981;--display:'Instrument Serif',Georgia,serif;--body:'DM Sans',system-ui,sans-serif}
      *{box-sizing:border-box}
      html{background:var(--bg);color:var(--text);font-family:var(--body)}
      body{margin:0;min-height:100vh;background:radial-gradient(ellipse 65% 35% at 50% 0%,rgba(14,165,233,.13),transparent 70%),var(--bg)}
      a{color:inherit}
      .nav{min-height:64px;padding:0 clamp(1rem,4vw,2.5rem);display:flex;align-items:center;justify-content:space-between;gap:1rem;border-bottom:1px solid var(--border);background:rgba(5,10,14,.82)}
      .brand{font-weight:600;text-decoration:none}.brand span{color:var(--muted);font-weight:400}
      .nav-links,.resources{display:flex;align-items:center;flex-wrap:wrap;gap:.5rem}
      .nav-links a,.resources a{min-height:44px;display:inline-flex;align-items:center;padding:0 .85rem;border-radius:7px;color:var(--secondary);font-size:.84rem;text-decoration:none}
      .nav-links a:hover,.resources a:hover{color:var(--text);background:rgba(56,189,248,.08)}
      main{width:min(900px,calc(100% - 2rem));margin:0 auto}
      .hero{padding:clamp(5rem,12vw,8rem) 0 4rem;text-align:center}
      .kicker{color:var(--brand);font-size:.75rem;font-weight:700;letter-spacing:.11em;text-transform:uppercase}
      h1{max-width:760px;margin:1rem auto;font-family:var(--display);font-size:clamp(3rem,8vw,5.4rem);font-weight:400;line-height:.96;letter-spacing:-.025em}
      .lede{max-width:650px;margin:1.4rem auto;color:var(--secondary);font-size:1.05rem;line-height:1.7}
      .resources{justify-content:center;margin-top:2rem}
      .resources a{border:1px solid var(--border-bright);background:rgba(14,165,233,.05)}
      .timeline{padding-bottom:7rem}
      article{display:grid;grid-template-columns:150px minmax(0,1fr);gap:2rem;padding:2rem 0;border-top:1px solid var(--border)}
      time{color:var(--muted);font-size:.86rem;font-weight:600}
      h2{margin:0 0 .65rem;font-size:1.3rem;letter-spacing:-.015em}
      article p{max-width:70ch;margin:0;color:var(--secondary);line-height:1.72}
      ul{display:flex;flex-wrap:wrap;gap:.5rem;margin:1rem 0 0;padding:0;list-style:none}
      li{padding:.28rem .6rem;border-radius:999px;background:rgba(16,185,129,.1);color:#6ee7b7;font-size:.72rem;font-weight:700}
      footer{display:flex;justify-content:space-between;gap:1rem;padding:2rem clamp(1rem,4vw,2.5rem);border-top:1px solid var(--border);color:var(--muted);font-size:.82rem}
      footer div{display:flex;flex-wrap:wrap;gap:1rem}
      footer a:hover{color:var(--text)}
      @media(max-width:640px){.nav{align-items:flex-start;padding-block:.8rem}.nav-links{justify-content:flex-end}.nav-links a{padding:0 .5rem}article{grid-template-columns:1fr;gap:.65rem}footer{flex-direction:column}}
    </style>
  </head>
  <body>
    <nav class="nav" aria-label="Primary navigation">
      <a class="brand" href="/">sass-maker <span>/ AI Gateway</span></a>
      <div class="nav-links">
        <a href="/getting-started">Docs</a>
        <a href="/status">Status</a>
        <a href="/changelog" aria-current="page">Changelog</a>
        <a href="/dashboard">Dashboard</a>
      </div>
    </nav>
    <main>
      <header class="hero">
        <div class="kicker">Product history, maintained here</div>
        <h1>What changed in the gateway</h1>
        <p class="lede">
          Meaningful, verified updates to routing, model support, documentation, and operating
          safety. Planned work stays in GitHub Issues.
        </p>
        <div class="resources" aria-label="Project resources">
          <a href={roadmapUrl}>Roadmap</a>
          <a href={sourceUrl}>Source</a>
        </div>
      </header>
      <section class="timeline" aria-label="AI Gateway releases">
        {entries.map((entry) => (
          <article>
            <time>{entry.date}</time>
            <div>
              <h2>{entry.title}</h2>
              <p>{entry.body}</p>
              <ul aria-label="Update categories">{entry.tags.map((tag) => <li>{tag}</li>)}</ul>
            </div>
          </article>
        ))}
      </section>
    </main>
    <footer>
      <span>Best-effort free compute, with the limits visible.</span>
      <div>
        <a href="/getting-started">Docs</a>
        <a href={roadmapUrl}>Roadmap</a>
        <a href={sourceUrl}>Source</a>
      </div>
    </footer>
  </body>
</html>
