      </div>
      <div class="nav-right">
        <a class="nav-status" href={`${gw}/health`} target="_blank" style="text-decoration:none">
          <span class="status-dot"></span>
          Live health status
        </a>
        <a class="nav-cta" href="/authentication/" data-app-health-event="access_requirements.opened">
          Access requirements
          <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
        </a>
      </div>
    </nav>

    <section class="hero">
      <Fragment set:html={homeHero.replaceAll("__ORIGIN__", gw)} />

    </section>

    <section class="proof-strip">
      <Fragment set:html={homeProof.replaceAll("__ORIGIN__", gw)} />

    </section>

    <section class="features-section">
      <Fragment set:html={homeFeatures.replaceAll("__ORIGIN__", gw)} />

    </section>

    <section class="code-section">
      <Fragment set:html={homeQuickstart.replaceAll("__ORIGIN__", gw)} />
<script>
        document.querySelectorAll('.code-tab[data-panel]').forEach(function(t) {
          t.addEventListener('click', function() {
            document.querySelectorAll('.code-tab[data-panel]').forEach(function(x) { x.classList.remove('active'); });
            t.classList.add('active');
            document.querySelectorAll('#panel-curl,#panel-sdk').forEach(function(p) { p.style.display = 'none'; });
            document.getElementById('panel-' + t.dataset.panel).style.display = 'block';
          });
        });
      </script>
<script>
        import { publicProof } from '../lib/public-proof';
        fetch('https://ai-gateway.sassmaker.com/v1/stats/providers')
          .then(r => r.ok ? r.json() : null)
          .then(data => {
            const proof = publicProof(data);
            if (!proof) return;
            const requests = document.querySelector('#proof-requests .proof-accent');
            const savings = document.querySelector('#proof-savings .proof-accent');
            if (requests) requests.textContent = proof.requests;
            if (savings) savings.textContent = proof.savings;
          }).catch(() => {});
      </script>
    </section>

