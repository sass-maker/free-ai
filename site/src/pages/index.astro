        align-items: start;
        justify-content: initial;
      }
      fleet-footer-extension .footer-links {
        display: grid;
        width: 100%;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
      }
      fleet-footer-extension .footer-col {
        display: flex;
        min-width: 0;
        flex-direction: column;
