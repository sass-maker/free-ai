---
import aboutContent from '../content/public/about.html?raw';
import { publicPageMeta } from '../data/public-content.mjs';
const { title, description } = publicPageMeta.about;
const gw = publicPageMeta.origin;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: title,
  description,
  url: `${gw}/about`,
  isPartOf: { '@id': `${gw}/#website` },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={`${gw}/about/`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`${gw}/about`} />
    <meta property="og:image" content={`${gw}/icon.svg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <style is:global>
      body { font-family: ui-sans-serif, system-ui, sans-serif; background: #09090b; color: #e4e4e7; margin: 0; padding: 0; }
      main { max-width: 720px; margin: 0 auto; padding: 64px 24px; line-height: 1.7; }
      h1 { font-size: 32px; margin: 0; color: #fbbf24; }
      h2 { font-size: 18px; margin-top: 32px; color: #fde68a; }
      a { color: #fbbf24; }
      code { background: #18181b; padding: 1px 4px; border-radius: 4px; font-size: 13px; }
      ul { padding-left: 24px; }
      li { margin: 4px 0; }
      p { color: #d4d4d8; }
    </style>
  </head>
  <body>
    <main><Fragment set:html={aboutContent} /></main>
  </body>
</html>
